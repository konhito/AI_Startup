# Copy to .env. The website and mock chat work without cloud credentials.
PROVIDER=mock
MODEL_NAME=glm
DATABASE_PATH=data/unbound.db
PORT=8080
# Public deployment: set HTTPS origin and COOKIE_SECURE=true.
PUBLIC_ORIGIN=http://127.0.0.1:8080
COOKIE_SECURE=false
# Optional unmetered operator keys; NEVER distribute these to customers.
API_KEYS=
# Optional administrator key for manual credit grants. Generate 32+ random characters.
ADMIN_API_KEY=

# All prices are retail preview rates in MICRO USD per million tokens.
# 1 USD = 1,000,000 micro USD. Configure your margins before selling access.
INPUT_PRICE_MICRO_USD=200000
OUTPUT_PRICE_MICRO_USD=800000
OPENROUTER_INPUT_PRICE_MICRO_USD=500000
OPENROUTER_OUTPUT_PRICE_MICRO_USD=1000000
# Disabled by default to prevent signup farming against paid inference.
TRIAL_CREDIT_MICRO_USD=0
REQUESTS_PER_MINUTE=60
MAX_INPUT_TOKENS=12288
MAX_OUTPUT_TOKENS=4096
MAX_STREAMS=32
STREAM_TIMEOUT=300

# Auto route uses OpenRouter when configured; otherwise the self-hosted/mock worker.
# When configured, ArliAI takes priority for auto so the chatbot can use the
# free Qwen3.5-27B-Derestricted plan. Keep this key server-side.
ARLIAI_API_KEY=
ARLIAI_BASE_URL=https://api.arliai.com/v1
ARLIAI_MODEL=Qwen3.5-27B-Derestricted
# Keep the basic chatbot responsive; API clients can explicitly request reasoning.
ARLIAI_REASONING_EFFORT=none
# Zero is appropriate for an internal/free MVP. Set retail rates before charging users.
ARLIAI_INPUT_PRICE_MICRO_USD=0
ARLIAI_OUTPUT_PRICE_MICRO_USD=0

# OpenRouter is the next hosted route when ArliAI is not configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Explicit GLM-5.3 route through OpenRouter. Retail rates include your margin;
# verify them against current upstream pricing before launch.
OPENROUTER_GLM53_MODEL=z-ai/glm-5.3
OPENROUTER_GLM53_INPUT_PRICE_MICRO_USD=1500000
OPENROUTER_GLM53_OUTPUT_PRICE_MICRO_USD=5000000
# Fallback only for HTTP 429/500/502/503/504 before streaming begins.
ROUTER_FALLBACK=true

IDLE_SECONDS=300
STARTUP_TIMEOUT=900
MAX_CONCURRENT=8
# For PROVIDER=gcp: existing VM on a private static IP, worker API key and ADC.
UPSTREAM_URL=http://10.0.0.10:8000
UPSTREAM_API_KEY=
GCP_PROJECT=
GCP_ZONE=
GCP_INSTANCE=

# Optional Stripe hosted checkout. Keep all three blank to disable checkout.
# Live mode requires PUBLIC_ORIGIN=https://... and COOKIE_SECURE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
